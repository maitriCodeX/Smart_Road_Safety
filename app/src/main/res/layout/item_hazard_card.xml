<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivHazardIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_hazards"
                app:tint="@color/hazard_btn_bg" />

            <!-- Hazard title / type -->
            <TextView
                android:id="@+id/tvHazardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Individual Hazard (Pothole Cluster)"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHazardSeverityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFEBEE"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="CRITICAL"
                android:textColor="@color/hazard_btn_bg"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Near location info as requested: 'Near: the place it is near to e.g. pothole is near to s-dmart' -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F8F9FA"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_location"
                app:tint="@color/nav_bar_bg" />

            <TextView
                android:id="@+id/tvNearbyLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Near: 50m past S-DMart, Kudasan Crossroad"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHazardDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="Multiple deep edge fractures and craters detected by IMU jerk sensor"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
